{
    "inbounds": [
        {
            "tag": "IN-Hysteria2",
            "listen": "0.0.0.0",
            "port": 53568,
            "protocol": "hysteria",
            "settings": {
                "version": 2
            },
            "streamSettings": {
                "network": "hysteria",
                "security": "tls",
                "tlsSettings": {
                    "serverName": "www.google.com", // SNI
                    "alpn": [
                        "h3"
                    ], // 这里需要显式写 h3 ，请注意。
                    "certificates": [
                        {
                            "usage": "encipherment",
                            "certificateFile": "C:\\Users\\Administrator\\Downloads\\Xray\\www.google.com-chain.pem",
                            "keyFile": "C:\\Users\\Administrator\\Downloads\\Xray\\www.google.com.pem"
                        }
                    ] // 证书设置
                },
                "hysteriaSettings": {
                    "version": 2,
                    "auth": "f1eead3-e80-41c-944-ccd06e3c91" // Hysteria 密码
                },
                "finalmask": {
                    "quicParams": {
                        "congestion": "brutal",
                        "brutalUp": "100 mbps",
                        "brutalDown": "100 mbps" // 当与客户端协商启用 brutal ，服务器端使用的速率
                    }
                }
            }
        }
    ]
}